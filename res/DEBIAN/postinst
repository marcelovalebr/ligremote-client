#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/ligremote/ligremote /usr/bin/ligremote

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/ligremote.service ]; then
			rm -f /etc/systemd/system/ligremote.service /usr/lib/systemd/system/ligremote.service /usr/lib/systemd/user/ligremote.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/ligremote/files/systemd/ligremote.service /usr/lib/systemd/system/ligremote.service
		# try fix error in Ubuntu 18.04
		# Failed to reload ligremote.service: Unit ligremote.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/ligremote.service:10: Executable path is not absolute: pkill -f "ligremote --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/ligremote.service
		fi
		systemctl daemon-reload
		systemctl enable ligremote
		systemctl start ligremote
	fi
fi
