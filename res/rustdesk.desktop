[Desktop Entry]
Name=LIG Remote
GenericName=Remote Desktop
Comment=Remote Desktop
Exec=ligremote %u
Icon=ligremote
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=internet;linux;remote-control;ligit;rdp;remote-desktop;vnc;
Actions=new-window;
StartupWMClass=ligremote

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Open a New Window
Exec=ligremote %u
